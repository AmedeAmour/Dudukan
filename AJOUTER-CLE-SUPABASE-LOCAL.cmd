@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$key = Read-Host 'Colle ici la cle Supabase SECRET qui commence par sb_secret_'; $key = ($key -replace '\r|\n','').Trim(); if ($key -notmatch '^sb_secret_') { Write-Host 'Cle refusee: elle doit commencer par sb_secret_.' -ForegroundColor Red; pause; exit 1 }; $path = Join-Path (Get-Location) '.env.local'; $lines = @(); if (Test-Path $path) { $lines = Get-Content -LiteralPath $path }; $updated = $false; $next = foreach ($line in $lines) { if ($line -match '^SUPABASE_SERVICE_ROLE_KEY\s*=') { $updated = $true; 'SUPABASE_SERVICE_ROLE_KEY=' + $key } else { $line } }; if (-not $updated) { $next += 'SUPABASE_SERVICE_ROLE_KEY=' + $key }; Set-Content -LiteralPath $path -Value $next; Write-Host 'Cle Supabase ajoutee dans .env.local.' -ForegroundColor Green; pause"
